rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 0: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isSignedIn() && getUserData().role == role; }
    function isAdmin() { return hasRole('admin'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validators ---

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'userId', 'residentName', 'phone', 'address', 'volume', 'status', 'requestedDate', 'requestedTime', 'createdAt', 'paymentStatus', 'paymentMethod']) &&
             data.id is string && data.id.size() <= 64 &&
             data.userId == request.auth.uid &&
             data.residentName is string && data.residentName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.address is string && data.address.size() <= 500 &&
             data.volume is string &&
             data.status in ['Pending', 'Confirmed', 'En Route', 'Delivered'] &&
             data.requestedDate is string &&
             data.requestedTime is string &&
             // In realistic app we use server timestamps, but if app uses Date.now(), we might need fuzzy check or trust it if userId matches
             data.createdAt is number && 
             data.paymentStatus in ['Paid', 'Pending'] &&
             data.paymentMethod in ['UPI', 'Card', 'Cash'] &&
             (!('priority' in data) || data.priority is bool);
    }

    function isValidComplaint(data) {
      return data.keys().hasAll(['id', 'residentName', 'phone', 'issueType', 'description', 'status', 'createdAt', 'userId']) &&
             data.id is string &&
             data.userId == request.auth.uid &&
             data.status in ['Open', 'Resolved'] &&
             data.createdAt is number;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['society', 'resident', 'driver', 'admin'];
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      // No listing users for non-admins
      allow list: if isAdmin();
      
      // Setup initial profile
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && incoming().role != 'admin'; 
      
      // Update profile
      allow update: if isSignedIn() && isOwner(userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone']) && 
                    isValidUser(incoming());
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin() || hasRole('driver'));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || hasRole('driver'));
      
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming());
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        // User cancelling their own pending booking
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && existing().status == 'Pending' && incoming().status == 'Cancelled') ||
        // Driver updating status/ETA
        (hasRole('driver') && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'eta', 'tankerId', 'driverName', 'driverPhone']) && existing().status != 'Delivered')
      );
    }

    match /complaints/{complaintId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidId(complaintId) && isValidComplaint(incoming());
      
      allow update: if isAdmin(); // Only admin can reply/resolve
    }
  }
}
